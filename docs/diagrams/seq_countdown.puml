@startuml seq_raceState_COUNTDOWN
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor Navy
skinparam sequenceParticipantBackgroundColor AliceBlue
skinparam noteBackgroundColor LightYellow
skinparam noteBorderColor DarkOrange
skinparam sequenceGroupBorderThickness 1.5

title Sequence: raceState(COUNTDOWN) [DerbyTrack]

' ============================================================
' PARTICIPANTS
' ============================================================
participant "Tree\nLights\n(74HC595)" as TREE
participant "Button\nLeft"       as BL_BTN
participant "Button\nRight"      as BR_BTN
participant "Gate L"             as GL
participant "Gate R"             as GR
participant "Start\nController"  as SC
participant "Finish\nController" as FC

note over TREE
  Both Left and Right trees are driven by
  one 74HC595 shift register via a single
  8-bit updateLights() call. LIGHT_BL and
  LIGHT_BR are separate bits; Y1/Y2/Y3/GO
  are shared bits that light both sides.
end note

' ============================================================
' MODE: GATEDROP
' Standard countdown, gates drop automatically at GO.
' ============================================================
group raceMode = GateDrop
  SC -> TREE : updateLights(BL+BR+Y3)  [500 ms]
  SC -> TREE : updateLights(BL+BR+Y2)  [500 ms]
  SC -> TREE : updateLights(BL+BR+Y1)  [500 ms]
  SC -> TREE : updateLights(BL+BR+GO)
  SC -> GL   : dropGate(gateL)
  SC -> GR   : dropGate(gateR)
  SC -> FC   : MSG_RACE_STATE(RACING)
  FC --> SC  : MSG_ACK
end

' ============================================================
' MODE: REACTION STD
' 500 ms stages. Drivers hold buttons; each release drops
' their lane's gate and starts their reaction timer.
' Both buttons are monitored concurrently every loop().
' ============================================================
group raceMode = ReactionStd
  SC -> TREE : updateLights(BL+BR+Y3)  [500 ms]
  SC -> TREE : updateLights(BL+BR+Y2)  [500 ms]
  SC -> TREE : updateLights(BL+BR+Y1)  [500 ms]

  note over BL_BTN, BR_BTN
    handleEarlyStarts() runs every loop during countdown.
    If a button is pressed while gate is up before GO:
    gate drops, foul flag set, carStartUs recorded.
    Left and Right are checked independently.
  end note

  note over BL_BTN, BR_BTN
    After GO: handleTrackTriggers() runs in RACING state.
    Each button press independently records carStartUs
    and drops that lane's gate. Both are concurrent.
  end note

  SC -> TREE : updateLights(BL+BR+GO)

  BL_BTN -> SC : buttonPressed(Left)
  SC -> GL     : dropGate(gateL)
  SC -> SC     : raceTime.leftStartUs = now
  SC -> SC     : foulL = false  [clean start]

  BR_BTN -> SC : buttonPressed(Right)
  SC -> GR     : dropGate(gateR)
  SC -> SC     : raceTime.rightStartUs = now
  SC -> SC     : foulR = false  [clean start]

  SC -> FC : MSG_RACE_STATE(RACING)
  FC --> SC : MSG_ACK
end

' ============================================================
' MODE: REACTION PRO
' Single 400 ms stage: all three yellows light simultaneously.
' Gate drop behavior identical to ReactionStd after GO.
' ============================================================
group raceMode = ReactPro
  note over TREE
    Pro Tree: tickCountdownState() jumps from CD_STAGED
    directly to CD_Y1 (skipping Y2 and Y3).
    buildLightConfig(CD_Y1, PRO) returns Y3+Y2+Y1 combined.
    One 400 ms stage, all three yellows lit at once.
  end note

  SC -> TREE : updateLights(BL+BR+Y3+Y2+Y1)  [400 ms, all three yellows simultaneously]
  SC -> TREE : updateLights(BL+BR+GO)

  BL_BTN -> SC : buttonPressed(Left)
  SC -> GL     : dropGate(gateL)
  SC -> SC     : raceTime.leftStartUs = now
  SC -> SC     : foulL = false  [clean start]

  BR_BTN -> SC : buttonPressed(Right)
  SC -> GR     : dropGate(gateR)
  SC -> SC     : raceTime.rightStartUs = now
  SC -> SC     : foulR = false  [clean start]

  SC -> FC : MSG_RACE_STATE(RACING)
  FC --> SC : MSG_ACK
end

note over SC
  Foul handling (any reaction mode):
  - Early press before GO: gate drops immediately,
    foul = true, carStartUs captured.
  - reactionTimeUs is calculated in RACING state.
  - If both drivers foul: worst foul (FL or FR) shown;
    lesser infraction's time is added to elapsed time.
end note

@enduml
