@startuml startController_STM
skinparam state {
  BackgroundColor AliceBlue
  BorderColor Navy
  FontSize 11
  ArrowFontSize 10
}
skinparam noteBackgroundColor LightYellow
skinparam noteBorderColor DarkOrange

title startController State Machine

note as N_RX
  rxSerial() is called at the top of every loop() iteration,
  in every state. It is not shown on individual states.
end note

[*] --> Setup

' ============================================================
' SETUP
' ============================================================
state "Setup" as Setup {
  Setup : do / setupSerial()
  Setup : do / setupLights()
  Setup : do / setupGates()
  Setup : do / setupButtons()
}

Setup --> IDLE : / void loop()

' ============================================================
' IDLE  (composite: raceMode sub-states managed by modeMachine)
' ============================================================
state "IDLE" as IDLE {
  IDLE : entry / cd.state = CD_IDLE
  IDLE : entry / updateLights(LIGHT_OFF)
  IDLE : entry / dropGate(gateL), dropGate(gateR)
  IDLE : do / updateBlink()
  IDLE : do / handleModeChanges()
  IDLE : do / if Start pressed (not during blink) then stm.target = RACE_STAGING
  IDLE : do / stm.rxTransition(rx.State)
  IDLE : do / stm.selfTransition(stm.target)

  state "GATEDROP\n[LIGHT_Y1]" as M_GD
  state "REACTION\n[LIGHT_Y2]"  as M_RE
  state "PRO\n[LIGHT_Y3]"       as M_PR
  state "DIAL-IN\n[LIGHT_GO]"   as M_DI #line.dashed

  note right of M_DI
    future: MODE_DIALIIN is defined
    but the button cycle skips it.
    nextMode(): PRO -> GATEDROP.
  end note

  [*]   --> M_GD
  M_GD --> M_RE : Button_Mode
  M_RE --> M_PR : Button_Mode
  M_PR --> M_GD : Button_Mode
}

note right of IDLE
  modeMachine (mdm) runs inside IDLE.
  Each mode change blinks the new
  mode's indicator light 3x (250 ms).
  Mode changes are coordinated with
  finishController via MSG_RACE_MODE.
end note

' ============================================================
' STAGING
' ============================================================
state "STAGING" as STAGING {
  STAGING : entry / returnGates()
  STAGING : entry / updateLights(LIGHT_BL | LIGHT_BR)
  STAGING : entry / blinkState.active = false
  STAGING : do / updateBlink()
  STAGING : do / if gateStatus.returnActive then returnGates()
  STAGING : do / monitor RFID for car ID  [future]
  STAGING : do / tx car ID to finishController  [future]
  STAGING : do / rx car ID confirmation  [future]
  STAGING : do / if Start pressed (not during blink) then stm.target = RACE_COUNTDOWN
  STAGING : do / if Mode pressed (not during blink) then stm.target = RACE_IDLE
  STAGING : do / stm.selfTransition(stm.target)
}

' ============================================================
' COUNTDOWN
' ============================================================
state "COUNTDOWN" as COUNTDOWN {
  COUNTDOWN : entry / cd.state = CD_STAGED, startDelay = 0
  COUNTDOWN : do / handleEarlyStarts(tNow, mode)  [reaction modes only]
  COUNTDOWN : do / cd.state = tickCountdownState(mode, cd.state)
  COUNTDOWN : do / if CD_GO then handleCountdownGoActions()
  COUNTDOWN : do / updateLights(buildLightConfig(cd.state, FL, FR, mode))
  COUNTDOWN : do / stm.selfTransition(stm.target)
}

note right of COUNTDOWN
  handleCountdownGoActions() at CD_GO:
  . raceStartUs = micros()
  . stm.target = RACE_RACING
  . GateDrop mode: dropGate(gateL+R),
      leftStartUs = rightStartUs = raceStartUs
  . Reaction modes: gates stay up;
      drivers hold buttons to release in RACING
  . txRaceStart(0b0001) sent to finishController
      (retry up to 3x, 50 ms timeout each)
end note

' ============================================================
' RACING
' ============================================================
state "RACING" as RACING {
  RACING : entry / pending = {leftReact=false, rightReact=false, foulStatus=true}
  RACING : entry / build foulMask from raceResults.leftFoul + rightFoul
  RACING : entry / resetTxState for FOUL, LEFT_REACT, RIGHT_REACT
  RACING : do / handleTrackTriggers()  [reaction modes: btn press -> dropGate + record carStartUs]
  RACING : do / calcReactionTimes() once gate drops
  RACING : do / drain PendingMsgs one at a time: MSG_FOUL then MSG_LEFT_REACT then MSG_RIGHT_REACT
  RACING : do / stm.rxTransition(rx.State)  [blocked until all PendingMsgs sent]
}

note right of RACING
  PendingMsgs guard: stm.rxTransition()
  is not called until foulStatus,
  leftReact, and rightReact are all
  TX_ACKED or timed out. This prevents
  a premature COMPLETE transition before
  the finishController has reaction data.
end note

' ============================================================
' COMPLETE
' ============================================================
state "COMPLETE" as COMPLETE {
  COMPLETE : entry / winLightsPend = true, winLightTimer = millis()
  COMPLETE : entry / cancelBlink()
  COMPLETE : do / handleDisplayAdvance()
  COMPLETE : do / updateBlink()
  COMPLETE : do / if winLightsPend AND (rx.WinnerReceived OR 2 s timeout):
  COMPLETE : do /   startBlink(winner pattern), winLightsPend = false
  COMPLETE : do / if !winLightsPend AND !updateBlink() then stm.rxTransition(rx.State)
}

note right of COMPLETE
  Winner blink (driven by MSG_WINNER from finishController):
  . Left wins:  startBlink(GO|FR, FR, 3x, 250ms, GO|FR)
  . Right wins: startBlink(GO|FL, FL, 3x, 250ms, GO|FL)
  . Tie:        startBlink(GO, OFF, 3x, 250ms, GO)
  . No result (double-foul/DNF): no blink, winLightsPend cleared
  winLightsPend held until rx.WinnerReceived flag is set by
  MSG_WINNER handler, or 2-second fallback timeout expires.
  Return to IDLE is driven by finishController
  sending MSG_RACE_STATE(IDLE).
end note

' ============================================================
' TESTING  (4-phase self-test; hold MODE at power-up to enter)
' ============================================================
state "TESTING" as TESTING {
  TESTING : entry / rt.reset(); txRaceState(RACE_TEST) [ping FC]
  TESTING : do / Phase 0: wait FC ACK (2s); blue 3x = pass, code 107 = no FC (non-fatal)
  TESTING : do / Phase 1: chase all 8 lights L->R, R->L; 3x all-on/all-off (150ms/500ms steps)
  TESTING : do / Phase 2: returnGates(); verify areLanesReady() (codes 101/102); dropGate(L/R)
  TESTING : do / Phase 3: prompt START, MODE, LEFT, RIGHT buttons (GO blinks; 5s each; codes 103-106)
  TESTING : do / Phase 4: GO stays green (all pass) or FL+FR blink N times (N = fail count); loops
  TESTING : note: exit via power-cycle; future: MSG_RACE_STATE(IDLE) from Race Manager
}

' ============================================================
' TRANSITIONS
' ============================================================
IDLE      --> STAGING   : Button_Start\n(not during blink)
IDLE      --> TESTING   : MODE held at power-up\n[or MSG_RACE_STATE(TEST)]

STAGING   --> COUNTDOWN : Button_Start\n[MSG_RACE_STATE(COUNTDOWN) TX_ACKED]
STAGING   --> IDLE      : Button_Mode\n[MSG_RACE_STATE(IDLE) TX_ACKED]

COUNTDOWN --> RACING    : cdState == CD_GO\n[MSG_RACE_STATE(RACING) TX_ACKED]
COUNTDOWN --> IDLE      : MSG_RACE_START TX_TIMEOUT/TX_FAILED\n[stm.forceIdle()]

RACING    --> COMPLETE  : MSG_RACE_STATE(COMPLETE)\n[after all PendingMsgs drained]
RACING    --> IDLE      : MSG_RACE_START or MSG_FOUL TX_TIMEOUT/TX_FAILED\n[stm.forceIdle()]

COMPLETE  --> IDLE      : MSG_RACE_STATE(IDLE)\n[sent by finishController]


@enduml
