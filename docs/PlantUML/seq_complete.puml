@startuml seq_raceState_COMPLETE
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor Navy
skinparam sequenceParticipantBackgroundColor AliceBlue
skinparam noteBackgroundColor LightYellow
skinparam noteBorderColor DarkOrange
skinparam sequenceGroupBorderThickness 1.5

title Sequence: raceState(COMPLETE) [DerbyTrack]

' ============================================================
' PARTICIPANTS
' ============================================================
participant "Button\nStart"      as BS
participant "Start\nController"  as SC
participant "Finish\nController" as FC
participant "Tree\nLights\n(74HC595)" as TREE
participant "Display\nLeft"      as DL
participant "Display\nRight"     as DR
participant "Race\nManager"      as RM   #line.dashed
participant "Projector"          as PROJ #line.dashed

note over RM, PROJ
  future: Race Manager (RPi via BLE) and Projector
  are not yet implemented.
end note

' ============================================================
' Display results on finish controller — mode-dependent
' ============================================================
alt [raceMode != GateDrop (Reaction or Pro)]
  FC -> DL : updateDisplay(leftResults.carTimeUs)
  FC -> DR : updateDisplay(rightResults.carTimeUs)

else [raceMode == GateDrop]
  FC -> DL : updateDisplay(leftResults.carTimeUs)
  FC -> DR : updateDisplay(rightResults.carTimeUs)
end

note over DL, DR
  In Reaction/Pro modes needReact = true.
  A second MSG_DISP_ADVANCE will display
  reaction times before returning to IDLE.
  In GateDrop mode needReact = false;
  first DISP_ADVANCE returns directly to IDLE.
end note

' ============================================================
' Finish controller computes result and sends MSG_WINNER to SC
' ============================================================
FC -> FC : computeRaceTimes()
FC -> SC : MSG_WINNER (winnerMask: bit0=L, bit1=R, bit2=tie, bit3=no result)
SC --> FC : MSG_ACK

' ============================================================
' Start controller drives winner lights from MSG_WINNER
' ============================================================
alt [rx.LeftWin]
  SC -> TREE : startBlink(GO|FR, FR, 3x 250ms, settle GO|FR)
  note right of TREE
    Left wins: green lights with
    right red (loser) flashing.
  end note
else [rx.RightWin]
  SC -> TREE : startBlink(GO|FL, FL, 3x 250ms, settle GO|FL)
  note right of TREE
    Right wins: green lights with
    left red (loser) flashing.
  end note
else [rx.Tie]
  SC -> TREE : startBlink(GO, OFF, 3x 250ms, settle GO)
end

' ============================================================
' Race results forwarded to Race Manager [future/BLE]
' ============================================================
note over FC, RM
  future/BLE: race results (carTimeUs, reactionTimeUs,
  foul, winner) transmitted to Race Manager via BLE
  once the GATT service is defined.
end note

RM -> PROJ : display(Race Results)  [future]

note over PROJ
  future: 4-second instant replay
  at 1/2 speed from camera buffer.
end note
PROJ -> PROJ : display(InstantReplay)  [future]

' ============================================================
' Start button advances displays — cycles through result screens
' MSG_DISP_ADVANCE #1: show reaction times (if Reaction/Pro mode)
' ============================================================
BS -> SC : isStartPressed()
SC -> FC : MSG_DISP_ADVANCE
FC --> SC : MSG_ACK

note over FC, DR
  If needReact == true:
  FC shows reaction times on both displays.
  needReact = false after this advance.
end note

FC -> DL : updateDisplay(leftResults.reactionTimeUs)  [if needReact]
FC -> DR : updateDisplay(rightResults.reactionTimeUs)  [if needReact]

' ============================================================
' MSG_DISP_ADVANCE #2 (or #1 in GateDrop): return to IDLE
' ============================================================
BS -> SC : isStartPressed()
SC -> FC : MSG_DISP_ADVANCE
FC --> SC : MSG_ACK

note over FC
  needReact == false:
  FC sets stm.target = RACE_IDLE
  and calls stm.selfTransition().
  FC initiates the coordinated return.
end note

FC -> SC : MSG_RACE_STATE(IDLE)
SC --> FC : MSG_ACK

@enduml
